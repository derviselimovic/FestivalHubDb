{
  "name": "festival-scraper",
  "version": "1.0.0",
  "description": "Festival data scraping and aggregation system",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "scrape:all": "ts-node src/cli/index.ts scrape all",
    "scrape:festicket": "ts-node src/cli/index.ts scrape festicket",
    "scrape:songkick": "ts-node src/cli/index.ts scrape songkick",
    "scrape:bandsintown": "ts-node src/cli/index.ts scrape bandsintown",
    "db:migrate": "ts-node src/cli/index.ts db migrate",
    "db:seed": "ts-node src/cli/index.ts db seed",
    "db:reset": "ts-node src/cli/index.ts db reset",
    "jobs:start": "ts-node src/jobs/scheduler.ts"
  },
  "keywords": [
    "festival",
    "scraper",
    "music",
    "events"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "playwright": "^1.40.0",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "commander": "^11.1.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "@sentry/node": "^7.91.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.9",
    "@types/cors": "^2.8.17",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
